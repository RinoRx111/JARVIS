# ==========================================
# JARVIS - ENVIRONMENT VARIABLES TEMPLATE
# Copy this file to .env and fill in the values.
# ==========================================

# --- SYSTEM CONFIGURATION ---
ENV=development
DEBUG=true
PROJECT_NAME="JARVIS - AI Operating System"

# --- BACKEND SERVER ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
SECRET_KEY=generate_a_secure_jwt_secret_key_here_minimum_32_chars
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- FRONTEND SERVER ---
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- POSTGRES DATABASE CONFIG ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=secure_postgres_password_here
POSTGRES_DB=jarvis_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg2://postgres:secure_postgres_password_here@postgres:5432/jarvis_db

# --- CHROMADB VECTOR STORE CONFIG ---
CHROMA_HOST=chromadb
CHROMA_PORT=8000

# --- LOCAL MODEL RUNTIME (OLLAMA) ---
OLLAMA_API_URL=http://host.docker.internal:11434

# --- LLM API KEYS ---
# Required for OpenAI GPT model capabilities (planning, parsing, speech-to-text)
OPENAI_API_KEY=your_openai_api_key_here

# Required for Google Gemini multimodal model operations
GEMINI_API_KEY=your_gemini_api_key_here

# Required for Anthropic Claude high-reasoning coding operations
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Required for Groq Llama-3 high-performance operations
GROQ_API_KEY=your_groq_api_key_here

# --- VOICE CONFIGURATION (TTS & STT) ---
# ElevenLabs API Key for voice synthesis
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
# Voice ID selector (ElevenLabs voice catalog ID)
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# --- GOOGLE OAUTH2 INTEGRATION (GMAIL & CALENDAR) ---
# Set up in Google Cloud Console
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# --- GITHUB INTEGRATION ---
# Personal Access Token (PAT) with repo scopes
GITHUB_TOKEN=your_github_personal_access_token_here

# --- WEATHER AND NEWS API KEYS ---
# OpenWeatherMap API Key
WEATHER_API_KEY=your_openweathermap_api_key_here
# GNews API Key
NEWS_API_KEY=your_gnews_api_key_here

# --- BROWSER AUTOMATION & SANDBOX CONFIG ---
# Playwright settings
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_TIMEOUT=30000

# Path inside docker or host for local agent file system manipulations
WORKSPACE_DIR=/tmp/jarvis_workspace

# ---------------------------------------------------------
# LANGSMITH OBSERVABILITY (Phase 16)
# ---------------------------------------------------------
# Set to true to enable detailed LLM traces and cost tracking
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT="https://api.smith.langchain.com"
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT="JARVIS-OS"
